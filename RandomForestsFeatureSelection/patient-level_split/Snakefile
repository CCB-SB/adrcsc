rule aggregate_results:
	input:
		scGR_defaultconfig = expand("results/{celltype}/final_selection_defaultconfig_and_performance.csv", celltype = config["celltypes"]),
		scGR_bestconfig = expand("results/{celltype}/final_selection_bestconfig_and_performance.csv", celltype = config["celltypes"]),
		DEGs = expand("results/{celltype}/DEGs_and_performance.csv", celltype = config["celltypes"]),
		ElasticNet = expand("results/{celltype}/ElasticNet_groupcv_features_and_performance.csv", celltype = config["celltypes"]),
		DeepLift = expand("results/{celltype}/DeepLift_features_and_performance.csv", celltype = config["celltypes"]),
		FeatureAblation = expand("results/{celltype}/FeatureAblation_features_and_performance.csv", celltype = config["celltypes"])
	output:
		"results/method_performance_comparison_results.csv"
	conda:
		"envs/scrf_env.yaml"
	script:
		"scripts/aggregate_results.R"

rule add_optimal_k_to_results:
	input:
		scGR_defaultconfig = expand("results/{celltype}/logs/final_feature_selection_with_defaultconfig.log", celltype = config["celltypes"]),
		scGR_bestconfig = expand("results/{celltype}/logs/final_feature_selection_with_bestconfig.log", celltype = config["celltypes"]),
		DEGs = expand("results/{celltype}/logs/train_and_test_DEGs_model.log", celltype = config["celltypes"]),
		ElasticNet = expand("results/{celltype}/logs/ElasticNet.log", celltype = config["celltypes"]),
		DeepLift = expand("results/{celltype}/logs/train_model_with_DeepLift_features.log", celltype = config["celltypes"]),
		FeatureAblation = expand("results/{celltype}/logs/train_model_with_FeatureAblation_features.log", celltype = config["celltypes"]),
		results_df = "results/method_performance_comparison_results.csv"
	output:
		"results/method_performance_comparison_results_with_optimal_k.csv"
	conda:
		"envs/scrf_env.yaml"
	script:
		"scripts/add_optimal_k_to_results.R"