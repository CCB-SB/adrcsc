	params:
		"{celltype}"
	log:
		"results/{celltype}/logs/final_feature_selection_with_bestconfig.log"
	threads:
		10
	conda:
		"envs/scrf_env.yaml"
	script:
		"scripts/final_feature_selection_with_bestconfig.R"

