rule data_split_TrainV1_V2_Test1:
	input:
		config["train_patients_seurat_obj"]
	output:
		"data/{celltype}/seu_trainV1.rds",
		"data/{celltype}/seu_validV2.rds",
		"data/{celltype}/seu_test1.rds"
	params:
		celltype = "{celltype}"
	log:
		"data/{celltype}/data_split.log"
	conda:
		"envs/scrf_env.yaml"
	script:
		"scripts/data_split_TrainV1_V2_Test1.R"

