	script:
		"scripts/rename_labels_for_scDeepFeatures.R"

rule DeepLift:
    input:
        data="data/{celltype}/data_for_scDeepFeatures.h5",
        labels="data/{celltype}/renamed_labels_for_scDeepFeatures.csv"
    output: 
        "results/{celltype}/DeepLift/DeepLift.0.AD.csv",
        "results/{celltype}/DeepLift/DeepLift.1.HC.csv"
    params:
        outdir="results/{celltype}/DeepLift/",
        script=config["scDeepFeatures"]
    log:
        "results/{celltype}/deeplift.log"
    conda:
        "envs/fsdl_env.yaml"
    shell:
        """
        python {params.script}\
         --method DeepLift\
         --train_data {input.data}\
         --train_label {input.labels}\
         --test_data {input.data}\
         --test_label {input.labels}\
         --only_pos "nope"\
         --save_fs_eachcell {params.outdir} > {log} 2>&1
        """

rule FeatureAblation:
    input:
        data="data/{celltype}/data_for_scDeepFeatures.h5",
        labels="data/{celltype}/renamed_labels_for_scDeepFeatures.csv"
    output:
        "results/{celltype}/FeatureAblation/FeatureAblation.0.AD.csv",
        "results/{celltype}/FeatureAblation/FeatureAblation.1.HC.csv"
    params:
        outdir="results/{celltype}/FeatureAblation/",
        script=config["scDeepFeatures"]
    log:
        "results/{celltype}/featureablation.log"
    conda:
        "envs/fsdl_env.yaml"
    shell:
        """
        python {params.script}\
         --method FeatureAblation\
         --train_data {input.data}\
         --train_label {input.labels}\
         --test_data {input.data}\
         --test_label {input.labels}\
         --only_pos "nope"\
         --save_fs_eachcell {params.outdir} > {log} 2>&1
        """

